# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection URL (PostgreSQL)
# For the local embedded Postgres runner (npm run db:start), use port 5433:
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/miniledger?schema=public"

# If using a standard system PostgreSQL or Docker instance on port 5432:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/miniledger?schema=public"

# JWT Authentication
JWT_SECRET="replace_with_a_secure_random_string_in_production"
JWT_EXPIRES_IN="7d"

# Mock Phone OTP Settings
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Local Embedded Database Settings (used by npm run db:start)
LOCAL_DB_PORT=5433
